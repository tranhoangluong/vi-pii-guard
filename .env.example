# OpenAI-compatible endpoint that receives redacted requests
VPG_UPSTREAM_BASE_URL=https://api.openai.com/v1
# Leave empty to forward the client's Authorization header instead
VPG_UPSTREAM_API_KEY=
VPG_UPSTREAM_TIMEOUT_SECONDS=60

# Optional fine-tuned NER model (Hugging Face id or local path); needs the `ner` extra
VPG_NER_MODEL=
VPG_MIN_SCORE=0.5

# Placeholder mappings are kept in memory for this long after the last use
VPG_SESSION_TTL_SECONDS=3600
VPG_MAX_SESSIONS=10000
